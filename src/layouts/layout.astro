---
import "@/styles/global.css";
import { buttonVariants } from "@/components/ui/button";
import { SITE, socialLinks } from "@/lib/site";
import { cn } from "@/lib/utils";

interface Props {
  title?: string;
  /** Replaces the whole <title> (no site-name suffix), e.g. on the homepage */
  fullTitle?: string;
  description?: string;
  /** og:type — "article" for posts/weeknotes/zettles */
  type?: "website" | "article";
  /** ISO date for article:published_time */
  publishedTime?: string;
  /** ISO date for article:modified_time */
  modifiedTime?: string;
  /** URL of the markdown version of this page, for agents */
  markdownUrl?: string;
  /** page-specific og image path, defaults to the site-wide card */
  ogImage?: string;
  /** alt text for the og image */
  ogImageAlt?: string;
  /** keeps the page out of search indexes (the 404 page) */
  noindex?: boolean;
  /** JSON-LD document rendered into the head, usually built with src/lib/schema.ts */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  fullTitle,
  description = SITE.description,
  type = "website",
  publishedTime,
  modifiedTime,
  markdownUrl,
  ogImage: ogImagePath,
  ogImageAlt,
  noindex = false,
  schema,
} = Astro.props;

const titleSuffix = ` · ${SITE.name}`;
// keep <title> within ~60 characters so search results do not truncate it
let pageTitle: string = fullTitle ?? SITE.name;
if (!fullTitle && title) {
  const withSuffix = `${title}${titleSuffix}`;
  pageTitle = withSuffix.length <= 60 ? withSuffix : title;
}
// the site name is already shown as og:site_name, so social titles skip the suffix
const socialTitle = title ?? fullTitle ?? SITE.name;
const year = new Date().getFullYear();
// pages are folder-based, so the trailing-slash form is the canonical one
const canonicalPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site);
const ogImage = new URL(ogImagePath ?? "og.png", Astro.site);
const imageAlt =
  ogImageAlt ??
  (ogImagePath
    ? `${socialTitle} — ${SITE.name}`
    : `${SITE.name}: ${SITE.tagline}`);
const robots = noindex
  ? "noindex, follow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const navLinks = [
  { href: "/posts/", label: "Posts" },
  { href: "/weeknotes/", label: "Weeknotes" },
  { href: "/zettles/", label: "Zettles" },
  { href: "/resume/", label: "Resume" },
];
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0a0a0a"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href={new URL("rss.xml", Astro.site)}
    />
    {markdownUrl && (
      <link
        rel="alternate"
        type="text/markdown"
        title={`${pageTitle} (Markdown)`}
        href={new URL(markdownUrl, Astro.site)}
      />
    )}
    <title>{pageTitle}</title>

    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {type === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === "article" && (modifiedTime ?? publishedTime) && (
      <meta
        property="article:modified_time"
        content={modifiedTime ?? publishedTime}
      />
    )}
    {type === "article" && (
      <meta property="article:author" content={`${SITE.url}/`} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:creator" content={SITE.twitter} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {schema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema).replaceAll("<", "\\u003c")}
      />
    )}
    <script is:inline>
      const darkQuery = window.matchMedia("(prefers-color-scheme: dark)");
      const applyTheme = () =>
        document.documentElement.classList.toggle("dark", darkQuery.matches);
      applyTheme();
      darkQuery.addEventListener("change", applyTheme);
    </script>
    <!-- Cloudflare Web Analytics -->
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "829a6d0063fd49bfb0ccc3feafdbaa9d"}'
    ></script>
  </head>
  <body class="antialiased">
    <div class="mx-auto flex min-h-screen max-w-2xl flex-col px-6 py-10">
      <header class="mb-12 flex flex-wrap items-center justify-between gap-4">
        <a href="/" class="font-semibold tracking-tight">{SITE.name}</a>
        <nav class="-mr-2.5 flex">
          {navLinks.map((link) => <a
            href={link.href}
            class={cn(
              buttonVariants({ variant: "ghost", size: "sm" }),
              "text-muted-foreground",
            )}
          >
            {link.label}
          </a>)}
        </nav>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <footer
        class="mt-16 flex flex-wrap items-baseline justify-between gap-4 border-t pt-6 text-sm text-muted-foreground"
      >
        <p>© {year} {SITE.name}</p>
        <nav class="flex gap-4 *:transition-colors hover:*:text-foreground">
          {socialLinks.map((link) => <a
            href={link.href}
            target="_blank"
            rel="me"
          >
            {link.label}
          </a>)}
          <a href="/rss.xml">RSS</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
