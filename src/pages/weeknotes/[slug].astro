---
import { getCollection, render } from "astro:content";

import { Badge } from "@/components/ui/badge";
import { Separator } from "@/components/ui/separator";
import Layout from "@/layouts/layout.astro";
import { formatDate } from "@/lib/dates";
import { articleNode, breadcrumbNode, countWords, graph } from "@/lib/schema";

export async function getStaticPaths() {
  const weeknotes = await getCollection("weeknotes");
  return weeknotes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

const formattedDate = note.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const path = `/weeknotes/${note.id}/`;
const ogPath = `/weeknotes/${note.id}.og.png`;

const schema = graph(
  articleNode({
    description: note.data.excerpt,
    image: ogPath,
    path,
    modified: note.data.updated,
    published: note.data.date,
    title: note.data.title,
    wordCount: countWords(note.body),
  }),
  breadcrumbNode([
    { name: "Home", path: "/" },
    { name: "Weeknotes", path: "/weeknotes/" },
    { name: note.data.title, path },
  ]),
);
---

<Layout
  title={note.data.title}
  description={note.data.excerpt}
  type="article"
  publishedTime={note.data.date.toISOString()}
  modifiedTime={note.data.updated?.toISOString()}
  markdownUrl={`/weeknotes/${note.id}.md`}
  ogImage={ogPath}
  schema={schema}
>
  <article>
    <header class="mb-10">
      <h1 class="text-3xl font-semibold tracking-tight text-balance">
        {note.data.title}
      </h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2">
        <Badge variant="secondary">
          <time datetime={note.data.date.toISOString()}>{formattedDate}</time>
        </Badge>
        {note.data.updated && <span class="text-sm text-muted-foreground">
          Updated
          <time datetime={note.data.updated.toISOString()}>
            {formatDate(note.data.updated)}
          </time>
        </span>}
      </div>
    </header>
    <div class="prose max-w-none prose-neutral dark:prose-invert">
      <Content />
    </div>
    {note.data.canonical && (
      <>
        <Separator className="mt-10" />
        <p class="mt-6 text-sm text-muted-foreground">
          Originally published on{" "}
          <a href={note.data.canonical} class="underline" target="_blank">
            Medium
          </a>
          .
        </p>
      </>
    )}
  </article>
</Layout>
