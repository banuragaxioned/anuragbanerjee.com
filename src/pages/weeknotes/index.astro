---
import { getCollection } from "astro:content";

import EntryList from "@/components/entry-list.astro";
import Layout from "@/layouts/layout.astro";
import { breadcrumbNode, collectionNode, graph } from "@/lib/schema";

const allWeeknotes = await getCollection("weeknotes");
const weeknotes = allWeeknotes.toSorted(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const description = "Weekly reflections and process notes by Anurag Banerjee.";
const schema = graph(
  collectionNode({
    description,
    entries: weeknotes.map((note) => `/weeknotes/${note.id}/`),
    name: "Weeknotes",
    path: "/weeknotes/",
  }),
  breadcrumbNode([
    { name: "Home", path: "/" },
    { name: "Weeknotes", path: "/weeknotes/" },
  ]),
);
---

<Layout title="Weeknotes" {description} {schema}>
  <h1 class="mb-8 text-3xl font-semibold tracking-tight">Weeknotes</h1>
  <EntryList
    entries={weeknotes.map((note) => ({
      href: `/weeknotes/${note.id}/`,
      title: note.data.title,
      date: note.data.date,
      excerpt: note.data.excerpt,
    }))}
  />
</Layout>
