---
import { getCollection, render } from "astro:content";

import { Badge } from "@/components/ui/badge";
import Layout from "@/layouts/layout.astro";
import { formatDate } from "@/lib/dates";
import { articleNode, breadcrumbNode, countWords, graph } from "@/lib/schema";

export async function getStaticPaths() {
  const zettles = await getCollection("zettles");
  return zettles.map((zettle) => ({
    params: { slug: zettle.id },
    props: { zettle },
  }));
}

const { zettle } = Astro.props;
const { Content } = await render(zettle);

const path = `/zettles/${zettle.id}/`;
const ogPath = `/zettles/${zettle.id}.og.png`;

const schema = graph(
  articleNode({
    description: zettle.data.excerpt,
    image: ogPath,
    path,
    modified: zettle.data.updated,
    published: zettle.data.date,
    title: zettle.data.title,
    wordCount: countWords(zettle.body),
  }),
  breadcrumbNode([
    { name: "Home", path: "/" },
    { name: "Zettles", path: "/zettles/" },
    { name: zettle.data.title, path },
  ]),
);
---

<Layout
  title={zettle.data.title}
  description={zettle.data.excerpt}
  type="article"
  publishedTime={zettle.data.date?.toISOString()}
  modifiedTime={zettle.data.updated?.toISOString()}
  markdownUrl={`/zettles/${zettle.id}.md`}
  ogImage={ogPath}
  schema={schema}
>
  <article>
    <header class="mb-10">
      <h1 class="text-3xl font-semibold tracking-tight text-balance">
        {zettle.data.title}
      </h1>
      {(zettle.data.date || zettle.data.updated) && <div
        class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2"
      >
        {zettle.data.date && <Badge variant="secondary">
          <time datetime={zettle.data.date.toISOString()}>
            {formatDate(zettle.data.date)}
          </time>
        </Badge>}
        {zettle.data.updated && <span class="text-sm text-muted-foreground">
          Updated
          <time datetime={zettle.data.updated.toISOString()}>
            {formatDate(zettle.data.updated)}
          </time>
        </span>}
      </div>}
    </header>
    <div class="prose max-w-none prose-neutral dark:prose-invert">
      <Content />
    </div>
  </article>
</Layout>
