---
import { getCollection } from "astro:content";

import EntryList from "@/components/entry-list.astro";
import Layout from "@/layouts/layout.astro";

const allPosts = await getCollection("posts");
const posts = allPosts.toSorted(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Posts" description="Essays and articles by Anurag Banerjee.">
  <h1 class="mb-8 text-3xl font-semibold tracking-tight">Posts</h1>
  <EntryList
    entries={posts.map((post) => ({
      href: `/posts/${post.id}/`,
      title: post.data.title,
      date: post.data.date,
      excerpt: post.data.excerpt,
    }))}
  />
</Layout>
