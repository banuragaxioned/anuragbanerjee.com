---
import { getCollection } from "astro:content";

import EntryList from "@/components/entry-list.astro";
import Layout from "@/layouts/layout.astro";
import { breadcrumbNode, collectionNode, graph } from "@/lib/schema";

const allPosts = await getCollection("posts");
const posts = allPosts.toSorted(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const description =
  "Writing by Anurag Banerjee on technology, work and life, from web development to leading teams.";
const schema = graph(
  collectionNode({
    description,
    entries: posts.map((post) => `/posts/${post.id}/`),
    name: "Posts",
    path: "/posts/",
  }),
  breadcrumbNode([
    { name: "Home", path: "/" },
    { name: "Posts", path: "/posts/" },
  ]),
);
---

<Layout title="Posts" {description} {schema}>
  <h1 class="mb-8 text-3xl font-semibold tracking-tight">Posts</h1>
  <EntryList
    entries={posts.map((post) => ({
      href: `/posts/${post.id}/`,
      title: post.data.title,
      date: post.data.date,
      excerpt: post.data.excerpt,
    }))}
  />
</Layout>
