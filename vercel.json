{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/github/",
      "destination": "https://github.com/imanuragbanerjee",
      "permanent": false
    },
    {
      "source": "/x/",
      "destination": "https://x.com/ianuragbanerjee",
      "permanent": false
    },
    {
      "source": "/twitter/",
      "destination": "https://x.com/ianuragbanerjee",
      "permanent": false
    },
    {
      "source": "/linkedin/",
      "destination": "https://linkedin.com/in/imanuragbanerjee",
      "permanent": false
    },
    {
      "source": "/instagram/",
      "destination": "https://www.instagram.com/imanuragbanerjee",
      "permanent": false
    },
    {
      "source": "/rss/",
      "destination": "/rss.xml",
      "permanent": true
    },
    {
      "source": "/feed/",
      "destination": "/rss.xml",
      "permanent": true
    },
    {
      "source": "/feed.xml",
      "destination": "/rss.xml",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/posts/",
      "permanent": true
    },
    {
      "source": "/zettles/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/zettles/:slug/",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "<https://anuragbanerjee.com/llms.txt>; rel=\"describedby\"; type=\"text/markdown\", <https://anuragbanerjee.com/llms.txt>; rel=\"llms-txt\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "<https://anuragbanerjee.com/llms.txt>; rel=\"describedby\"; type=\"text/markdown\", <https://anuragbanerjee.com/llms.txt>; rel=\"llms-txt\"; type=\"text/markdown\", <https://anuragbanerjee.com/index.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    }
  ]
}
