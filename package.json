{
  "name": "anuragbanerjee-com",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "bun scripts/generate-brand-assets.ts",
    "build": "next build",
    "check": "oxfmt . && oxlint .",
    "check:static": "bun scripts/check-static.ts",
    "dev": "next dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "lefthook install || true",
    "start": "next start",
    "taze": "taze",
    "taze:fix": "taze -w -i",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run build && bun run check:static"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "feed": "^6.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-mdx-import-media": "^1.4.0",
    "remark-frontmatter": "^5.0.0",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anuragbanerjee/oxfmt-config": "^0.1.1",
    "@anuragbanerjee/oxlint-config": "^0.1.2",
    "@anuragbanerjee/tsconfig": "^0.1.1",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "taze": "^21.3.0",
    "typescript": "^7.0.2"
  }
}
