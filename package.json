{
  "name": "second-brain",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "dev": "astro dev",
    "format": "oxfmt .",
    "preview": "astro preview",
    "taze": "taze",
    "taze:fix": "taze -w -i",
    "check": "oxfmt . && oxlint .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "lefthook install || true",
    "typecheck": "astro check",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run build"
  },
  "dependencies": {
