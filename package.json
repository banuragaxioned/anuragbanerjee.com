    "@tailwindcss/vite": "^4.3.5",
    "@vercel/functions": "^3.11.1",
    "astro": "^7.4.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
